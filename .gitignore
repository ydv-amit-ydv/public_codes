# ---------------------------------------------------------------------------
# Repo-wide ignores. Each project may add its own .gitignore for anything
# specific to it; those are additive, so nothing here needs repeating there.
# ---------------------------------------------------------------------------

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# --- virtualenvs (projects build these on first run) ---
.venv/
.venv*/
venv/
env/

# --- OS / editor noise ---
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/

# --- logs and scratch ---
*.log
logs_*.txt
.scratch/
tmp/

# ===========================================================================
# immunoforge
# ===========================================================================
# runtime state: runs, caches, learned timings, downloaded proteomes
# runtime state. The engine_* names are what an install made before the
# project was renamed to Immunoforge; both are ignored so an older checkout
# does not suddenly start offering its workspace for commit.
immunoforge_workspace/
immunoforge_config.json
engine_workspace/
engine_config.json
timings.json
# the eleven predictors are licensed separately and never redistributed here
immunoforge/MHC1/models/
immunoforge/MHC2/models/

# ===========================================================================
# circrna_opt
# ===========================================================================
third_party/
runs/

# ===========================================================================
# construct_design
# ===========================================================================
# constructs saved through the server at runtime; the shared library/ is kept
constructs/
construct_design/data/*.json

# ===========================================================================
# immune_sim
# ===========================================================================
# Datasets. The repository SHIPS a gzipped copy of each one (~8.6 MB total)
# so a clone can train and validate with no network at all - see
# immune_sim/DATA_SOURCES.md for where each came from and what to cite.
# A fresh harvest writes the plain .csv, which stays untracked: it is a local
# refresh of a file the bundle already provides, and dataio.py prefers it
# automatically when present.
immunoforge/immune_sim/data/*.csv
!immunoforge/immune_sim/data/*.csv.gz
# Trained model weights. Regenerate with: python3 model.py && python3 immunogenicity.py
immunoforge/immune_sim/models/*.pkl
immunoforge/immune_sim/models/immuno_curves.json
# Run outputs. The committed demo epitope set and figures are forced back in
# below so the project can be read without running anything.
immunoforge/immune_sim/results/*.csv
immunoforge/immune_sim/results/*_timecourse.csv
!immunoforge/immune_sim/results/demo_epitopes.csv

# ---------------------------------------------------------------------------
# Large binaries anywhere: keep the repo cloneable
# ---------------------------------------------------------------------------
*.pkl
*.joblib
*.h5
*.pt
*.pth
*.onnx
*.npz
*.parquet
*.sqlite
*.db
*.tar.gz
*.zip

# immune_sim: calibration runs started from the GUI. A candidate is a local
# experiment: it is not used by anything until it is explicitly promoted, and
# the promoted set (calibrated_wetlab.json) IS tracked. _prev.json is the
# one-step undo that promotion leaves behind.
immunoforge/immune_sim/models/calibrated_candidate_*.json
immunoforge/immune_sim/models/calibrated_wetlab_prev.json

# immune_sim: CMI-PB harvest (the bundle covers it; this is a local refresh)
immunoforge/immune_sim/data/cmipb_*.csv
immunoforge/immune_sim/results/*.json
!immunoforge/immune_sim/results/wetlab_validation_*.json
# validation outputs are small and are the evidence for the README claims
!immunoforge/immune_sim/results/external_validation.csv
!immunoforge/immune_sim/results/wetlab_validation_*.csv
!immunoforge/immune_sim/results/scorecard.csv
